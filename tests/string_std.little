test.assert(string.len("hello") is 5)
test.assert(string.len("") is 0)

var a = string.sub("hello", 0, 3)
test.assert(a is "hel")
var b = string.sub("hello", 3)
test.assert(b is "lo")

var h = string.concat("hello", " ", "world")
test.assert(h is "hello world")

var str_format = string.format("hello %s", "world")
var int_format = string.format("hello %d", 10)
var dbl_format = string.format("hello %f", 2.5)
var hex_format = string.format("hello %x", 255)
test.assert(str_format is "hello world")
test.assert(int_format is "hello 10")
test.assert(dbl_format is "hello 2.500000")
test.assert(hex_format is "hello ff")

var upval = 0
var c = fn() {
  upval = 10
}
var ptr = test.make_ptr()

test.assert(string.typeof(null) is "null")
test.assert(string.typeof(10) is "number")
test.assert(string.typeof(true) is "boolean")
test.assert(string.typeof("mystring") is "string")
test.assert(string.typeof(fn() {}) is "function")
test.assert(string.typeof(c) is "closure")
test.assert(string.typeof([]) is "array")
test.assert(string.typeof({}) is "table")
test.assert(string.typeof(string.typeof) is "native")
test.assert(string.typeof(ptr) is "ptr")
