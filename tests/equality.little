test.assert(null is null)
test.assert(null isnt true)
test.assert(null isnt false)

test.assert(42 is 42)
test.assert(0 is 0)
test.assert(-1 is -1)
test.assert(3.14 is 3.14)

test.assert(true is true)
test.assert(false is false)
test.assert(true isnt false)
test.assert(false isnt true)

test.assert("hello" is "hello")
test.assert("hello" isnt "world")
test.assert("" is "")
test.assert("a" isnt "b")

var f = fn() {}
test.assert(f is f)
test.assert(f isnt fn() {})

var upval = 0
var c = fn() {
  upval = 10
}
test.assert(c is c)
test.assert(c isnt f)

var a1 = [1, 2, 3]
var a2 = [1, 2, 3]
test.assert(a1 is a1)
test.assert(a1 isnt a2)

var t1 = {x: 10 y: 20}
var t2 = {x: 10 y: 20}
test.assert(t1 is t1)
test.assert(t1 isnt t2)

test.assert(test.assert is test.assert)
test.assert(test.assert isnt test.expect_error)

var p1 = test.make_ptr()
var p2 = test.make_ptr()
io.print(p1, p2)
test.assert(p1 is p1)
test.assert(p1 isnt p2)
