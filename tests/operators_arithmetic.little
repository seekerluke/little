test.assert(2 + 3 is 5)
test.assert(10 - 4 is 6)
test.assert(3 * 7 is 21)
test.assert(10 / 4 is 2.5)
test.assert(1 + 2 + 3 is 6)
test.assert(10 - 3 - 2 is 5)
test.assert(2 * 3 * 4 is 24)
test.assert(100 / 10 / 2 is 5)
test.assert(-5 + 10 is 5)
test.assert(0 + 0 is 0)
test.assert(0 * 999 is 0)
test.assert(1.5 + 2.5 is 4)
test.assert(10 / 3 is 10 / 3)
