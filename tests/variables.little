var a
test.assert(a is null)

var b = 10
test.assert(b is 10)

var c = (1 or 2)
test.assert(c is 1)

var d = (null or 5)
test.assert(d is 5)

var e = 0
test.assert(e is 0)

e = 20
test.assert(e is 20)

e = e + 5
test.assert(e is 25)

var f = "hello"
test.assert(f is "hello")

f = "world"
test.assert(f is "world")
